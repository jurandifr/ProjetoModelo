<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings>
      <setting id="name">Projeto Modelo</setting>
      <setting id="description">Exemplo de Interface</setting>
      <setting id="template">codescript</setting>
      <setting id="main_widget">tk1</setting>
      <setting id="module_namespace" />
      <setting id="module_name">desktop</setting>
      <setting id="main_classname">interface</setting>
      <setting id="output_dir">.</setting>
      <setting id="builder_namespace">custom_widgets</setting>
      <setting id="output_dir2" />
      <setting id="generate_code_onsave">False</setting>
      <setting id="use_i18n">False</setting>
      <setting id="all_ids_attributes">True</setting>
      <setting id="import_tkvariables">False</setting>
      <setting id="use_ttk_styledefinition_file">False</setting>
      <setting id="use_window_centering_code">False</setting>
      <setting id="ttk_style_definition_file" />
    </settings>
    <customwidgets />
    <resources />
  </project>
  <object class="tk.Tk" id="tk1">
    <property name="height">200</property>
    <property name="resizable">none</property>
    <property name="title" translatable="yes">Projeto Modelo</property>
    <property name="width">400</property>
    <containerlayout manager="pack">
      <property name="propagate">false</property>
    </containerlayout>
    <child>
      <object class="ttk.Label" id="label1">
        <property name="text" translatable="yes">label1</property>
        <layout manager="pack">
          <property name="expand">true</property>
          <property name="side">top</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Button" id="button1">
        <property name="command" type="command" cbtype="simple">executar</property>
        <property name="text" translatable="yes">executar</property>
        <layout manager="pack">
          <property name="padx">8</property>
          <property name="pady">8</property>
          <property name="side">bottom</property>
        </layout>
      </object>
    </child>
  </object>
</interface>
